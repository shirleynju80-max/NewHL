{
  "name": "dividend-etf-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "worker:deploy": "npm --prefix workers/data-api run deploy",
    "r2:upload": "bash scripts/cloudflare/upload_public_data_to_r2.sh",
    "release:worker-pages": "bash scripts/cloudflare/release_worker_pages.sh",
    "etf-products:generate": "node scripts/generate_etf_products.mjs",
    "etf-products:select": "node scripts/select_index_tracking_etfs.mjs",
    "etf-products:sync": "node scripts/sync_etf_products_monthly.mjs",
    "etf-products:verify": "node scripts/verify_etf_products.mjs",
    "backtest:cn-div": "tsx scripts/backtest_grid/run_scope_top5.ts --scope A股红利 --top 5",
    "backtest:cn-div:one": "tsx scripts/backtest_grid/run_scope_top5.ts --scope A股红利 --top 5 --code"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
