# 实时价服务镜像：tsx 直跑 TS，复用 worker 的 eastmoneyQuote。构建上下文须为仓库根目录。
FROM node:22-alpine
WORKDIR /app
RUN npm install -g tsx@4.19.2
COPY workers/data-api/src/eastmoneyQuote.ts ./workers/data-api/src/eastmoneyQuote.ts
COPY deploy/quote-server/server.ts ./deploy/quote-server/server.ts
ENV PORT=8787
EXPOSE 8787
CMD ["tsx", "deploy/quote-server/server.ts"]
